<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ds_ripple_light">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="@dimen/ds_radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ds_radius_control" />
            <gradient
                android:angle="270"
                android:endColor="@color/ds_primary"
                android:startColor="@color/ds_highlight"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/ds_border_button" />
        </shape>
    </item>
</ripple>
