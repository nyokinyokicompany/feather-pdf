<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ds_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="@dimen/ds_radius_panel" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ds_surface" />
                    <corners android:radius="@dimen/ds_radius_panel" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/ds_border_card" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/ds_radius_panel" />
                    <gradient
                        android:angle="315"
                        android:centerColor="#05FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:startColor="#1EFFFFFF"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
