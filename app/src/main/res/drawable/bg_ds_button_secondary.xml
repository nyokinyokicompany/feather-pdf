<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ds_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="@dimen/ds_radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface" />
            <corners android:radius="@dimen/ds_radius_control" />
            <stroke
                android:width="1dp"
                android:color="@color/ds_border_card" />
        </shape>
    </item>
</ripple>
